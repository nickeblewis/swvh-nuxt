# Copy to .env for local development. Never commit .env.
# In production these are set as Netlify environment variables.

# Required for the admin session cookie. 32+ characters.
# Generate one with: openssl rand -hex 32
NUXT_SESSION_PASSWORD=

# NETLIFY_DB_URL is NOT set here. The platform injects it, and `netlify dev`
# injects a local equivalent. Setting it here will point you at the wrong database.
# The one exception is passing it inline to `npm run admin:create` to create a
# production admin; see "Creating an admin user" in the README.
